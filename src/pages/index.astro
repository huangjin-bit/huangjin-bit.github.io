---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import CategorySection from '../components/CategorySection.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const recentPosts = allPosts.slice(0, 6);

const categories = [
  {
    title: '后端开发',
    description: '深入探索服务端架构、微服务、数据库优化与高并发系统设计',
    icon: 'server',
    color: 'var(--color-backend)',
    href: '/categories/backend',
    features: ['系统架构设计', '微服务与分布式', '数据库优化', 'API设计与实践'],
  },
  {
    title: '数据科学',
    description: '数据分析、可视化、统计建模与数据工程的实战经验分享',
    icon: 'bar-chart',
    color: 'var(--color-data-science)',
    href: '/categories/data-science',
    features: ['数据分析与可视化', '统计建模', '数据管道构建', '特征工程'],
  },
  {
    title: '人工智能',
    description: '机器学习、深度学习、NLP与AI前沿技术的探索与实践',
    icon: 'brain',
    color: 'var(--color-ai)',
    href: '/categories/ai',
    features: ['机器学习算法', '深度学习框架', 'NLP与大语言模型', 'AI工程化实践'],
  },
];
---

<BaseLayout title="首页">
  <HeroSection />

  <!-- Categories Section -->
  <section class="section categories-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">
          <Icon name="layers" size={24} color="var(--color-accent-primary)" />
          探索领域
        </h2>
        <p class="section-desc">三大核心技术星域，每一个方向都是一片未知的星云</p>
      </div>

      <div class="categories-grid">
        {categories.map((cat) => (
          <CategorySection {...cat} />
        ))}
      </div>
    </div>
  </section>

  <!-- Recent Posts Section -->
  <section class="section posts-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">
          <Icon name="sparkles" size={24} color="var(--color-accent-primary)" />
          最新文章
        </h2>
        <p class="section-desc">来自技术宇宙深处的最新信号</p>
      </div>

      <div class="posts-grid">
        {recentPosts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            heroImage={post.data.heroImage}
            category={post.data.category}
            tags={post.data.tags}
            slug={post.slug}
          />
        ))}
      </div>

      {allPosts.length > 6 && (
        <div class="section-action">
          <a href="/blog" class="view-all-btn">
            查看全部文章 →
          </a>
        </div>
      )}
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-card">
        <div class="cta-content">
          <h2 class="cta-title">加入这场宇宙探索之旅</h2>
          <p class="cta-desc">
            订阅博客，接收来自后端开发、数据科学与AI星域的最新探索报告。
          </p>
          <div class="cta-actions">
            <a href="/rss.xml" class="btn btn-primary"><Icon name="rss" size={16} color="#fff" /> 订阅 RSS</a>
            <a href="https://github.com/huangjin-bit" class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
              <Icon name="github" size={16} /> GitHub
            </a>
          </div>
        </div>
        <div class="cta-art">
          <div class="cta-orb"></div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding: var(--space-3xl) 0;
    position: relative;
    z-index: 1;
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .section-title {
    font-size: 2rem;
    font-weight: 900;
    margin-bottom: var(--space-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .title-icon {
    font-size: 1.5rem;
  }

  .section-desc {
    color: var(--color-text-muted);
    font-size: 1rem;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .section-action {
    text-align: center;
    margin-top: var(--space-2xl);
  }

  .view-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 2rem;
    border-radius: var(--radius-md);
    background: rgba(110, 142, 251, 0.08);
    border: 1px solid var(--color-border);
    color: var(--color-accent-primary);
    font-weight: 600;
    transition: var(--transition-normal);
    text-decoration: none;
  }

  .view-all-btn:hover {
    background: rgba(110, 142, 251, 0.15);
    border-color: var(--color-border-hover);
    transform: translateX(3px);
  }

  /* CTA Section */
  .cta-card {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-2xl);
    padding: var(--space-2xl) var(--space-3xl);
    border-radius: var(--radius-xl);
    background:
      url('/images/backgrounds/space-02-earth-orbit.jpg') center/cover no-repeat;
    background-blend-mode: overlay;
    background-color: rgba(5, 5, 16, 0.88);
    border: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
  }

  .cta-title {
    font-size: 1.8rem;
    font-weight: 900;
    margin-bottom: var(--space-sm);
    background: linear-gradient(135deg, var(--color-accent-primary), var(--color-accent-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .cta-desc {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
    max-width: 500px;
  }

  .cta-actions {
    display: flex;
    gap: var(--space-md);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.95rem;
    transition: var(--transition-normal);
    text-decoration: none;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--color-accent-primary), var(--color-accent-secondary));
    color: #fff;
    box-shadow: 0 4px 20px rgba(110, 142, 251, 0.3);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 30px rgba(110, 142, 251, 0.45);
    color: #fff;
  }

  .btn-secondary {
    background: rgba(110, 142, 251, 0.08);
    color: var(--color-accent-primary);
    border: 1px solid var(--color-border);
  }

  .btn-secondary:hover {
    background: rgba(110, 142, 251, 0.15);
    border-color: var(--color-border-hover);
    color: var(--color-accent-primary);
  }

  .cta-art {
    position: relative;
  }

  .cta-orb {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-accent-primary), var(--color-accent-secondary));
    opacity: 0.3;
    filter: blur(30px);
    animation: float 4s ease-in-out infinite;
  }

  @media (max-width: 768px) {
    .categories-grid {
      grid-template-columns: 1fr;
    }

    .posts-grid {
      grid-template-columns: 1fr;
    }

    .cta-card {
      grid-template-columns: 1fr;
      padding: var(--space-xl);
      text-align: center;
    }

    .cta-actions {
      justify-content: center;
      flex-wrap: wrap;
    }

    .cta-art {
      display: none;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
