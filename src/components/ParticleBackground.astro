---
---

<div class="starfield" id="starfield" aria-hidden="true">
  {/* Static twinkling stars — small */}
  {Array.from({ length: 80 }).map((_, i) => (
    <div
      class="star star-sm"
      style={`
        left: ${Math.random() * 100}%;
        top: ${Math.random() * 100}%;
        animation-delay: ${Math.random() * 6}s;
        animation-duration: ${2 + Math.random() * 4}s;
      `}
    />
  ))}
  {/* Medium stars */}
  {Array.from({ length: 30 }).map((_, i) => (
    <div
      class="star star-md"
      style={`
        left: ${Math.random() * 100}%;
        top: ${Math.random() * 100}%;
        animation-delay: ${Math.random() * 5}s;
        animation-duration: ${3 + Math.random() * 4}s;
      `}
    />
  ))}
  {/* Large bright stars */}
  {Array.from({ length: 8 }).map((_, i) => (
    <div
      class="star star-lg"
      style={`
        left: ${Math.random() * 100}%;
        top: ${Math.random() * 100}%;
        animation-delay: ${Math.random() * 4}s;
        animation-duration: ${4 + Math.random() * 3}s;
      `}
    />
  ))}
  {/* Slow-drifting shooting stars */}
  {Array.from({ length: 3 }).map((_, i) => (
    <div
      class="shooting-star"
      style={`
        top: ${10 + Math.random() * 40}%;
        animation-delay: ${i * 7 + Math.random() * 5}s;
        animation-duration: ${2 + Math.random() * 1.5}s;
      `}
    />
  ))}
</div>

<style>
  .starfield {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .star {
    position: absolute;
    border-radius: 50%;
    background: #fff;
    animation: twinkle ease-in-out infinite;
  }

  .star-sm {
    width: 1px;
    height: 1px;
    opacity: 0.4;
    box-shadow: 0 0 2px rgba(255, 255, 255, 0.3);
  }

  .star-md {
    width: 2px;
    height: 2px;
    opacity: 0.6;
    box-shadow: 0 0 4px rgba(180, 200, 255, 0.5);
  }

  .star-lg {
    width: 3px;
    height: 3px;
    opacity: 0.8;
    box-shadow: 0 0 8px rgba(110, 142, 251, 0.6), 0 0 16px rgba(110, 142, 251, 0.2);
  }

  .star-lg:nth-child(2n) {
    background: #c8d8ff;
  }

  .star-lg:nth-child(3n) {
    background: #ffe4c4;
    box-shadow: 0 0 8px rgba(255, 228, 196, 0.5), 0 0 16px rgba(255, 228, 196, 0.15);
  }

  @keyframes shooting {
    0% {
      transform: translateX(-100px) translateY(0);
      opacity: 0;
    }
    5% { opacity: 1; }
    70% { opacity: 1; }
    100% {
      transform: translateX(calc(100vw + 100px)) translateY(120px);
      opacity: 0;
    }
  }

  .shooting-star {
    position: absolute;
    left: -100px;
    width: 80px;
    height: 1px;
    background: linear-gradient(90deg, rgba(255,255,255,0.8), transparent);
    border-radius: 50%;
    animation: shooting linear infinite;
    opacity: 0;
  }
</style>
