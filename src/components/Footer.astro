---
import Icon from './Icon.astro';

const currentYear = new Date().getFullYear();
const links = [
  { label: 'GitHub', href: 'https://github.com/huangjin-bit', icon: 'github' },
  { label: 'RSS', href: '/rss.xml', icon: 'rss' },
];
---

<footer class="site-footer">
  <div class="footer-inner container">
    <div class="footer-grid">
      <div class="footer-brand">
        <span class="footer-logo"><Icon name="star" size={18} color="var(--color-accent-primary)" /> 星辰代码</span>
        <p class="footer-desc">向宇宙深处探索后端开发、数据科学与AI的未知边界</p>
      </div>

      <div class="footer-section">
        <h4 class="footer-heading">分类</h4>
        <ul class="footer-links">
          <li><a href="/categories/backend"><Icon name="server" size={14} /> 后端开发</a></li>
          <li><a href="/categories/data-science"><Icon name="bar-chart" size={14} /> 数据科学</a></li>
          <li><a href="/categories/ai"><Icon name="brain" size={14} /> 人工智能</a></li>
        </ul>
      </div>

      <div class="footer-section">
        <h4 class="footer-heading">链接</h4>
        <ul class="footer-links">
          {links.map((link) => (
            <li>
              <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
                <Icon name={link.icon} size={14} /> {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} 星辰代码. 使用 Astro 构建，部署于 GitHub Pages.</p>
      <p class="footer-quote">"宇宙的边界就是代码的边界，而我们永远在探索。"</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-3xl);
    border-top: 1px solid var(--color-border);
    background: rgba(5, 5, 16, 0.9);
    backdrop-filter: blur(10px);
  }

  .footer-inner {
    padding: var(--space-3xl) var(--space-lg) var(--space-xl);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }

  .footer-logo {
    font-size: 1.3rem;
    font-weight: 900;
    background: linear-gradient(135deg, var(--color-accent-primary), var(--color-accent-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .footer-desc {
    margin-top: var(--space-sm);
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .footer-heading {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-links a {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    transition: var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--color-accent-primary);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-lg);
    text-align: center;
  }

  .footer-bottom p {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  .footer-quote {
    font-style: italic;
    color: var(--color-accent-primary) !important;
    opacity: 0.7;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }
</style>
