---
import Icon from './Icon.astro';
---

<section class="hero">
  <div class="hero-inner container">
    <div class="hero-content">
      <div class="hero-badge animate-fade-in-up">
        <span class="badge-dot"></span>
        <span>后端开发 · 数据科学 · AI</span>
      </div>

      <h1 class="hero-title animate-fade-in-up delay-1">
        在代码的<span class="gradient-text">宇宙</span>中<br />
        探索未知的<span class="gradient-text-alt">无限边界</span>
      </h1>

      <p class="hero-desc animate-fade-in-up delay-2">
        这里是星辰代码，一个向宇宙深处探索技术边界的个人博客。<br />
        后端架构、数据科学与AI——每一行代码都是一次星际航行。
      </p>

      <div class="hero-actions animate-fade-in-up delay-3">
        <a href="/blog" class="btn btn-primary">
          <Icon name="pen-line" size={18} color="#fff" />
          <span>浏览文章</span>
        </a>
        <a href="/about" class="btn btn-secondary">
          <Icon name="sparkles" size={18} />
          <span>了解更多</span>
        </a>
      </div>

      <div class="hero-stats animate-fade-in-up delay-4">
        <div class="stat">
          <span class="stat-icon"><Icon name="server" size={18} color="var(--color-backend)" /></span>
          <span class="stat-label">后端开发</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-icon"><Icon name="bar-chart" size={18} color="var(--color-data-science)" /></span>
          <span class="stat-label">数据科学</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-icon"><Icon name="brain" size={18} color="var(--color-ai)" /></span>
          <span class="stat-label">人工智能</span>
        </div>
      </div>
    </div>

    <div class="hero-visual animate-fade-in delay-2">
      <div class="hero-art">
        <div class="art-ring ring-1"></div>
        <div class="art-ring ring-2"></div>
        <div class="art-ring ring-3"></div>
        <div class="art-core">
          <span class="core-icon"><Icon name="code" size={32} color="#fff" /></span>
        </div>
        <div class="orbit-dot dot-1"><Icon name="server" size={22} color="var(--color-backend)" /></div>
        <div class="orbit-dot dot-2"><Icon name="scatter-chart" size={22} color="var(--color-data-science)" /></div>
        <div class="orbit-dot dot-3"><Icon name="brain" size={22} color="var(--color-ai)" /></div>
      </div>
    </div>
  </div>

  <div class="hero-wave">
    <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0 60L48 55C96 50 192 40 288 45C384 50 480 70 576 75C672 80 768 70 864 60C960 50 1056 40 1152 45C1248 50 1344 70 1392 80L1440 90V120H0V60Z" fill="var(--color-bg-primary)" fill-opacity="0.5"/>
      <path d="M0 80L48 75C96 70 192 60 288 65C384 70 480 90 576 95C672 100 768 90 864 80C960 70 1056 60 1152 65C1248 70 1344 90 1392 100L1440 110V120H0V80Z" fill="var(--color-bg-primary)"/>
    </svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: var(--space-3xl) 0 6rem;
    overflow: hidden;
    min-height: 85vh;
    display: flex;
    align-items: center;
    /* NASA Deep Field starfield background */
    background:
      url('/images/backgrounds/space-01-deep-field.jpg') center/cover no-repeat;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(5,5,16,0.55) 0%, rgba(5,5,16,0.85) 70%, rgba(5,5,16,1) 100%),
      radial-gradient(ellipse at 25% 35%, rgba(110,142,251,0.12) 0%, transparent 55%),
      radial-gradient(ellipse at 75% 50%, rgba(167,119,227,0.08) 0%, transparent 50%);
    pointer-events: none;
    z-index: 0;
  }

  .hero::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 200px;
    background: linear-gradient(to top, var(--color-bg-primary) 0%, transparent 100%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3xl);
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: 2rem;
    background: rgba(110, 142, 251, 0.08);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(110, 142, 251, 0.15);
    font-size: 0.85rem;
    color: var(--color-accent-primary);
    margin-bottom: var(--space-lg);
    opacity: 0;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent-primary);
    animation: glow-pulse 2s ease-in-out infinite;
  }

  .hero-title {
    font-size: 3.2rem;
    font-weight: 900;
    line-height: 1.2;
    margin-bottom: var(--space-lg);
    opacity: 0;
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--color-accent-primary), var(--color-accent-tertiary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .gradient-text-alt {
    background: linear-gradient(135deg, var(--color-accent-secondary), var(--color-accent-primary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-desc {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: var(--space-xl);
    opacity: 0;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-md);
    margin-bottom: var(--space-2xl);
    opacity: 0;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.95rem;
    transition: var(--transition-normal);
    text-decoration: none;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--color-accent-primary), var(--color-accent-secondary));
    color: #fff;
    box-shadow: 0 4px 20px rgba(110, 142, 251, 0.3);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 30px rgba(110, 142, 251, 0.45);
    color: #fff;
  }

  .btn-secondary {
    background: rgba(110, 142, 251, 0.08);
    backdrop-filter: blur(8px);
    color: var(--color-accent-primary);
    border: 1px solid rgba(110, 142, 251, 0.2);
  }

  .btn-secondary:hover {
    background: rgba(110, 142, 251, 0.15);
    border-color: var(--color-border-hover);
    color: var(--color-accent-primary);
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    opacity: 0;
  }

  .stat {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .stat-icon {
    font-size: 1.2rem;
  }

  .stat-label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .stat-divider {
    width: 1px;
    height: 20px;
    background: var(--color-border);
  }

  /* Hero Visual - Animated Orbits */
  .hero-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
  }

  .hero-art {
    position: relative;
    width: 350px;
    height: 350px;
  }

  .art-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .ring-1 {
    width: 150px;
    height: 150px;
    border-color: rgba(110, 142, 251, 0.25);
    animation: float 4s ease-in-out infinite;
  }

  .ring-2 {
    width: 250px;
    height: 250px;
    border-color: rgba(167, 119, 227, 0.15);
    animation: float 5s ease-in-out infinite reverse;
  }

  .ring-3 {
    width: 340px;
    height: 340px;
    border-color: rgba(79, 195, 247, 0.1);
    animation: float 6s ease-in-out infinite;
  }

  .art-core {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-accent-primary), var(--color-accent-secondary));
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 40px rgba(110, 142, 251, 0.4), 0 0 80px rgba(167, 119, 227, 0.2);
    animation: glow-pulse 3s ease-in-out infinite;
  }

  .core-icon {
    font-size: 2rem;
    color: #fff;
  }

  @keyframes orbit {
    from { transform: rotate(0deg) translateX(var(--orbit-radius)) rotate(0deg); }
    to { transform: rotate(360deg) translateX(var(--orbit-radius)) rotate(-360deg); }
  }

  .orbit-dot {
    position: absolute;
    top: 50%;
    left: 50%;
    font-size: 1.5rem;
    margin: -0.75rem 0 0 -0.75rem;
    animation: orbit linear infinite;
  }

  .dot-1 {
    --orbit-radius: 75px;
    animation-duration: 8s;
  }

  .dot-2 {
    --orbit-radius: 125px;
    animation-duration: 12s;
    animation-direction: reverse;
  }

  .dot-3 {
    --orbit-radius: 170px;
    animation-duration: 16s;
  }

  .hero-wave {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    line-height: 0;
  }

  .hero-wave svg {
    width: 100%;
    height: 80px;
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: var(--space-2xl) 0 4rem;
    }

    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-title {
      font-size: 2.2rem;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-stats {
      justify-content: center;
      flex-wrap: wrap;
    }

    .hero-visual {
      order: -1;
    }

    .hero-art {
      width: 250px;
      height: 250px;
    }

    .ring-3 {
      width: 240px;
      height: 240px;
    }

    .dot-3 {
      --orbit-radius: 120px;
    }
  }
</style>
